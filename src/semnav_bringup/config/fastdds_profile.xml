<?xml version="1.0" encoding="UTF-8"?>
<!--
  SemNav Fast DDS profile (D-19). Exported as FASTRTPS_DEFAULT_PROFILES_FILE by the SemNav launch
  files. A 640x480 rgb8 image is 921,600 bytes, larger than Fast DDS 2.6's default 512 KB
  shared-memory segment, so images fell back to fragmented UDP and overflowed the default 208 KB
  socket receive buffer (kernel RcvbufErrors). A 10 MB segment keeps same-host images in shared
  memory; UDPv4 stays enabled for discovery and for processes started without this profile.
  The socket buffer request is capped by net.core.rmem_max / wmem_max (raised via sysctl, D-19).
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>semnav_shm</transport_id>
      <type>SHM</type>
      <segment_size>10485760</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>semnav_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="semnav_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>semnav_shm</transport_id>
        <transport_id>semnav_udp</transport_id>
      </userTransports>
      <sendSocketBufferSize>8388608</sendSocketBufferSize>
      <listenSocketBufferSize>8388608</listenSocketBufferSize>
    </rtps>
  </participant>
</profiles>
