<?xml version="1.0" encoding="UTF-8"?>
<!--
  SemNav CycloneDDS configuration (D-20). Exported as CYCLONEDDS_URI by the SemNav launch files,
  together with RMW_IMPLEMENTATION=rmw_cyclonedds_cpp. Cyclone sends same-host traffic over UDP,
  so a 921,600-byte camera image needs a large socket receive buffer; the request is capped by
  net.core.rmem_max (raised via /etc/sysctl.d/60-ros2-dds.conf, D-19).
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <Internal>
      <SocketReceiveBufferSize min="8MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
